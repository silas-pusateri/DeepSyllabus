# Database connection (set for production, not needed for local development)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Storage (set for production, not needed for local development)
BLOB_READ_WRITE_TOKEN=

# Mock mode configuration
USE_MOCK=false  # Set to true to use mock implementations instead of real services
MOCK_OPENAI=false  # Set to true to use mock OpenAI responses (defaults to USE_MOCK value)

# AI Configuration
OPENAI_API_KEY=  # OpenAI API key for all AI operations
DEFAULT_MODEL=gpt-3.5-turbo  # Default model for simple operations
AGENT_MODEL=gpt-4o  # Model for agent-based workflows (recommended: gpt-4o)

# DeepResearch MCP Configuration
MCP_ENABLED=true  # Set to false to disable MCP completely
MCP_SCRIPT_PATH=./mcp-server.js  # Path to the MCP server script